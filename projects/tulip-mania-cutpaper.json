 ],
 "sources": [
  {
   "claim": "Semper Augustus sold for 10,000 guilders at its height; skilled labourers earned about 150 to 350 guilders a year",
   "source": "Wikipedia, Tulip mania (citing Goldgar 2007 and Mackay 1841)",
   "url": "https://en.wikipedia.org/wiki/Tulip_mania"
  },
  {
   "claim": "Trading met in taverns, as forward contracts for bulbs still in the ground; the Dutch called it windhandel (wind trade)",
   "source": "Wikipedia, Tulip mania",
   "url": "https://en.wikipedia.org/wiki/Tulip_mania"
  },
  {
   "claim": "Collapse began in early February 1637 when a Haarlem auction found no buyers; Haarlem later let buyers cancel contracts for 3.5 percent of the price",
   "source": "Wikipedia, Tulip mania",
   "url": "https://en.wikipedia.org/wiki/Tulip_mania"
  },
  {
   "claim": "Anne Goldgar found fewer than half a dozen notable participants in financial trouble; Mackay's 1841 account relied on satirical pamphlets",
   "source": "Anne Goldgar, Tulipmania: Money, Honor, and Knowledge in the Dutch Golden Age (2007), via Wikipedia",
   "url": "https://en.wikipedia.org/wiki/Tulip_mania"
  }
 ],
 "notes": "The speech bubble THEY ATE BULBS! points to an old story in the satire (a sailor eating a bulb) and is shown as part of the legend, not as fact. The bars in scene 2 are to scale (300 vs 10,000) only roughly."
}